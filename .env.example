# askpdf runs locally with Ollama by default and needs none of these. Set them in your
# shell (or a gitignored .env) only to use a bring-your-own-key chat model.

# API key for an OpenAI-compatible chat endpoint. Read from the environment only;
# never logged.
ASKPDF_API_KEY=

# Sending page excerpts to a non-loopback endpoint is refused unless this is 1
# (or --allow-remote is passed).
ASKPDF_ALLOW_REMOTE=0
